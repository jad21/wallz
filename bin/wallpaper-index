#!/usr/bin/env python3
"""CLI manual para listar carpetas GitHub y regenerar el índice de fondos."""

import argparse
import os
from pathlib import Path
import shutil
import sys

# Objetivo: usar el binario Go del paquete cuando esté integrado en el perfil Nix.
wallz = shutil.which("wallz")
if wallz:
    os.execv(wallz, [wallz, "index", *sys.argv[1:]])

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from wallpaper_rotation.indexer import folders, refresh


def main() -> int:
    # Objetivo: separar la actualización de GitHub del temporizador sin API remota.
    parser = argparse.ArgumentParser(description="Catálogo de fondos GitHub")
    parser.add_argument("command", choices=("folders", "refresh"))
    parser.add_argument("url", nargs="?", help="URL GitHub para folders")
    parser.add_argument("--config", type=Path,
                        default=Path("/home/jad21/develop/wallz/config.toml"))
    args = parser.parse_args()
    if args.command == "folders":
        if not args.url:
            parser.error("folders requiere una URL pública de GitHub")
        for folder in folders(args.url):
            print(folder)
    else:
        if args.url:
            parser.error("refresh no acepta una URL; usa config.toml del proyecto")
        count = refresh(Path("/home/jad21/Imágenes/wallpaper"), config_path=args.config)
        print(f"index.jsonl: {count} contenidos únicos")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError) as error:
        print(f"wallpaper-index: {error}", file=sys.stderr)
        sys.exit(1)
